<!-- Contact details and form -->
<section>
  <div class="container">
    <div class="row g-5">
      <!-- Office details -->
      <div class="col-lg-6">
        <div class="contact-office wow fadeInUp" data-wow-delay=".0s">


          <div class="contact-detail">
            <h4>Visit Us</h4>
            <address>
              142/147, Ghaswala Estate, Opp. 24 Karat,<br />
              Swami Vivekanand Rd, Jogeshwari West,<br />
              Mumbai, Maharashtra 400102
            </address>
          </div>

          <div class="contact-detail">
            <h4>Call Us</h4>
            <p>
              <a href="tel:+912247509991">22 47509991</a>
              <span class="phone-divider">/</span>
              <a href="tel:+918655650601">8655650601</a>
            </p>
          </div>

          <div class="contact-detail">
            <h4>Email Us</h4>
            <p>
              <a href="mailto:info@eurodecor.co.in">
                info@eurodecor.co.in
              </a>
            </p>
          </div>
        </div>

        <!-- Google Map: coordinates supplied in your location link -->
        <div
          class="contact-map rounded-1 overflow-hidden wow fadeInUp"
          data-wow-delay=".2s"
        >
          <iframe
            title="Euro Decor office location in Jogeshwari West, Mumbai"
            src="https://maps.google.com/maps?q=19.1408748626709%2C72.84165954589844&z=16&output=embed"
            width="100%"
            height="340"
            style="border: 0;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <a
          class="contact-directions"
          href="https://www.google.com/maps/dir/?api=1&destination=19.1408748626709%2C72.84165954589844"
          target="_blank"
          rel="noopener noreferrer"
        >
          Get Directions
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </div>

      <!-- Enquiry form -->
      <div class="col-lg-6">
        <p class="col-lg-10 wow fadeInUp">
          Looking for veneers, laminates, or decorative surfaces for your
          project? Share your material requirements below, and our team will
          get in touch.
        </p>

        <div class="spacer-single"></div>

        <div class="relative wow fadeInUp" data-wow-delay=".4s">
          <form
            action="#"
            data-local-form=""
            id="contact_form"
            method="post"
            name="contactForm"
          >
            <div class="row g-4">
              <div class="col-lg-12">
                <div class="field-set mb-3">
                  <input
                    class="form-control"
                    id="name"
                    name="name"
                    placeholder="Your Name"
                    aria-label="Your Name"
                    autocomplete="name"
                    required
                    type="text"
                  />
                </div>

                <div class="field-set mb-3">
                  <input
                    class="form-control"
                    id="email"
                    name="email"
                    placeholder="Your Email"
                    aria-label="Your Email"
                    autocomplete="email"
                    required
                    type="email"
                  />
                </div>

                <div class="field-set mb-3">
                  <input
                    class="form-control"
                    id="phone"
                    name="phone"
                    placeholder="Your Phone"
                    aria-label="Your Phone"
                    autocomplete="tel"
                    required
                    type="tel"
                  />
                </div>

                <div class="field-set mb-3">
                  <textarea
                    class="form-control h-100px"
                    id="message"
                    name="message"
                    placeholder="Your Message"
                    aria-label="Your Message"
                    required
                  ></textarea>
                </div>
              </div>
            </div>

            <div id="submit">
              <input
                class="btn-main w-100"
                id="send_message"
                type="submit"
                value="Send Message"
              />
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

