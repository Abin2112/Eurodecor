---
const { collection } = Astro.props;
---
<section id="our-collection">
  <div class="container">
    <div class="row g-4 mb-5 align-items-end justify-content-between">
      <div class="col-lg-7">
        <div class="subtitle wow fadeInUp">Our Collection</div>
        <h2 class="wow fadeInUp" data-wow-delay=".2s">{collection.heading}</h2>
      </div>
      <div class="col-lg-4"><p class="mb-0 wow fadeInUp" data-wow-delay=".4s">{collection.intro}</p></div>
    </div>
    <div class="row g-4 gy-5">
      {collection.products.map((product, index) => (
        <div class="col-lg-4 col-sm-6 wow fadeInUp" data-wow-delay={`${(index % 3) * .2}s`}>
          <div class="hover relative overflow-hidden text-light">
            <div class="relative overflow-hidden">
              <img src={product.image} alt={product.name} class="w-100 hover-scale-1-2 collection-product-image" loading="lazy" />
            </div>
            <span class="abs top-0 start-0 p-4 z-2">{String(index + 1).padStart(2, '0')}</span>
            <div class="gradient-edge-bottom h-50"></div>
            <div class="abs bottom-0 p-4 z-2"><h3 class="mb-0 text-light">{product.name}</h3></div>
          </div>
          <p class="mt-3 mb-0">{product.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .collection-product-image { aspect-ratio: 4 / 5; object-fit: cover; }
</style>
