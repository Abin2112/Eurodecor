---
import Header from '../components/intrio/Header.astro';
import Footer from '../components/intrio/Footer.astro';
import SitePanel from '../components/intrio/SitePanel.astro';
interface Props {
  headerVariant?: 'index' | 'index-2' | 'index-3' | 'index-4' | 'index-5' | 'index-6' | 'about' | 'contact';
  slider?: boolean;
}
const { headerVariant = 'index', slider = false } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Intrio — Interior Design Website Template" />
    <link rel="icon" href="/images/icon.webp" type="image/webp" />
    <title>Intrio — Interior Design Website Template</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" id="bootstrap" />
    <link href="/css/plugins.css" rel="stylesheet" />
    <link href="/css/swiper.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
    <link href="/css/coloring.css" rel="stylesheet" />
    <link href="/css/colors/scheme-01.css" rel="stylesheet" id="colors" />
    <link href="/css/site-fixes.css" rel="stylesheet" />
	</head>
	<body>
    <Header variant={headerVariant} />
    <main>
      <a href="#" id="back-to-top" aria-label="Back to top"></a>
      <div id="de-loader" aria-hidden="true"></div>
      <slot />
    </main>
    <SitePanel />
    <Footer />
    <script is:inline src="/js/vendors.js"></script>
    <script is:inline src="/js/designesia.js"></script>
    {slider && <script is:inline src="/js/swiper.js"></script>}
    {slider && <script is:inline src="/js/custom-swiper-1.js"></script>}
    <script is:inline src="/js/site.js"></script>
	</body>
</html>

