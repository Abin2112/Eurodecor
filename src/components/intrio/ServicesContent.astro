
---
---

<section class="bg-dark text-light relative jarallax">
    <img alt="" class="jarallax-img" src="/images/background/2.webp"/>
    <div class="container relative z-2">
        <div class="row gy-4 gx-5 align-items-center">
            <div class="col-md-8">
                <div class="spacer-double sm-hide"></div>
                <h1 class="mb-3 wow fadeInUp" data-wow-delay=".2s">Products</h1>
                <ul class="crumb wow fadeInUp">
                    <li><a href="/index.html">Home</a></li>
                    <li class="active">Products</li>
                </ul>
            </div>
            <div class="col-md-4"></div>
        </div>
    </div>
    <div class="gradient-edge-bottom h-50 op-6"></div>
    <div class="sw-overlay op-5"></div>
</section>

<section>
    <div class="container">
        <div class="row g-4" id="gallery">

            <!-- Laminates -->
            <div class="item col-lg-6 col-md-6 col-sm-6">
                <div class="hover">
                    <div class="relative overflow-hidden">
                        <a class="d-block hover relative text-light" href="/services/laminates.html">
                            <img alt="" class="abs w-80px p-20 z-2 top-0 end-0 p-4 hover-op-1" src="/images/misc/up-right-arrow.webp"/>
                            <div class="abs z-4 p-4 pb-0 bottom-0 mb-0">
                                <h2 class="fs-40 wow scale-in-mask" data-wow-delay=".6s">Laminates</h2>
                            </div>
                            <div class="relative overflow-hidden rounded-1 wow scaleIn" data-wow-duration="1.5s">
                                <img alt="" class="w-100 hover-scale-1-2 product-image" src="https://res.cloudinary.com/g81wchrp/image/upload/v1793705442/laminate.png"/>
                            </div>
                            <div class="gradient-edge-bottom h-70"></div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Veneers -->
            <div class="item col-lg-6 col-md-6 col-sm-6">
                <div class="hover">
                    <div class="relative overflow-hidden">
                        <a class="d-block hover relative text-light" href="/services/veneers.html">
                            <img alt="" class="abs w-80px p-20 z-2 top-0 end-0 p-4 hover-op-1" src="/images/misc/up-right-arrow.webp"/>
                            <div class="abs z-4 p-4 pb-0 bottom-0 mb-0">
                                <h2 class="fs-40 wow scale-in-mask" data-wow-delay=".6s">VENEERS</h2>
                            </div>
                            <div class="relative overflow-hidden rounded-1 wow scaleIn" data-wow-duration="1.5s">
                                <img alt="" class="w-100 hover-scale-1-2 product-image" src="https://res.cloudinary.com/g81wchrp/image/upload/v1793707186/veneer.jpg_1.png"/>
                            </div>
                            <div class="gradient-edge-bottom h-70"></div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Marquetry -->
            <div class="item col-lg-6 col-md-6 col-sm-6">
                <div class="hover">
                    <div class="relative overflow-hidden">
                        <a class="d-block hover relative text-light" href="/services/marquetry.html">
                            <img alt="" class="abs w-80px p-20 z-2 top-0 end-0 p-4 hover-op-1" src="/images/misc/up-right-arrow.webp"/>
                            <div class="abs z-4 p-4 pb-0 bottom-0 mb-0">
                                <h2 class="fs-40 wow scale-in-mask" data-wow-delay=".6s">MARQUETRY</h2>
                            </div>
                            <div class="relative overflow-hidden rounded-1 wow scaleIn" data-wow-duration="1.5s">
                                <img alt="" class="w-100 hover-scale-1-2 product-image" src="https://res.cloudinary.com/g81wchrp/image/upload/v1793705179/marquetry.png"/>
                            </div>
                            <div class="gradient-edge-bottom h-70"></div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Parquetry -->
            <div class="item col-lg-6 col-md-6 col-sm-6">
                <div class="hover">
                    <div class="relative overflow-hidden">
                        <a class="d-block hover relative text-light" href="/services/parquetry.html">
                            <img alt="" class="abs w-80px p-20 z-2 top-0 end-0 p-4 hover-op-1" src="/images/misc/up-right-arrow.webp"/>
                            <div class="abs z-4 p-4 pb-0 bottom-0 mb-0">
                                <h2 class="fs-40 wow scale-in-mask" data-wow-delay=".6s">PARQUETRY</h2>
                            </div>
                            <div class="relative overflow-hidden rounded-1 wow scaleIn" data-wow-duration="1.5s">
                                <img alt="" class="w-100 hover-scale-1-2 product-image" src="https://res.cloudinary.com/g81wchrp/image/upload/v1793705176/parquetry.png"/>
                            </div>
                            <div class="gradient-edge-bottom h-70"></div>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    #gallery .product-image {
        width: 100%;
        height: 550px;
        object-fit: cover;
    }

    @media (max-width: 576px) {
        #gallery .item {
            width: 100%;
        }

        #gallery .product-image {
            height: 400px;
        }
    }
</style>
