
---
interface Props {
  variant?: string;
}
---

<header class="transparent">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class="de-flex sm-pt10">
          <!-- Logo -->
          <div class="de-flex-col">
            <div id="logo">
              <a href="/index.html">
                <img
                  class="logo-main"
                  src="/images/logo-white.webp"
                  alt="Eurodecor"
                />
                <img
                  class="logo-scroll"
                  src="/images/logo-white.webp"
                  alt="Eurodecor"
                />
                <img
                  class="logo-mobile"
                  src="/images/logo-white.webp"
                  alt="Eurodecor"
                />
              </a>
            </div>
          </div>

          <!-- Navigation -->
          <div class="de-flex-col header-col-mid">
            <ul id="mainmenu">
              <li>
                <a class="menu-item" href="/index.html">Home</a>
              </li>

              <li>
                <a class="menu-item" href="/about.html">About Us</a>
              </li>

              <li>
                <a class="menu-item" href="/services.html">Products</a>
              </li>

              <li>
                <a class="menu-item" href="/projects.html">Projects</a>
              </li>

              <li>
                <a class="menu-item" href="#">Catalogue</a>

                <ul>
                  <li>
                    <a href="public/catalouges/EURO Mica Interactive.pdf" download>
                      Euro Mica
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="public/catalouges/EURO Veneer Folder 2026 Interactive.pdf" download>
                      Euro Veneer 2026
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="public/catalouges/ESS Folder 2026 Interactive PDF.pdf" download>
                      ESS
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="public/catalouges/EURO Diet Folder.pdf" download>
                      Euro Diet
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="public/catalouges/Nexo Folder 2026.pdf" download>
                      Nexo 2026
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="public/catalouges/Pro Plus 2026 Interactive.pdf" download>
                      Pro Plus 2026
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="public/catalouges/Zero by EURO Interactive.pdf" download>
                      Zero By Euro
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>
                </ul>
              </li>

              <li>
                <a class="menu-item" href="/contact.html">Contact Us</a>
              </li>
            </ul>
          </div>

          <!-- Right-side controls -->
          <div class="de-flex-col">
            <div class="menu_side_area">
              <!-- Mobile navigation toggle -->
              <span
                id="menu-btn"
                role="button"
                tabindex="0"
                aria-label="Toggle navigation"
                aria-controls="mainmenu"
                aria-expanded="false"
              ></span>
            </div>

            <!-- Original desktop hamburger / information panel -->
            <div
              id="btn-extra"
              role="button"
              tabindex="0"
              aria-label="Open information panel"
              aria-controls="extra-wrap"
            >
              <span></span>
              <span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  
#mainmenu ul li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

.catalogue-download {
    font-size: 13px;
    margin-left: auto;
    padding-left: 25px;
    opacity: 0.7;
    transition: all 0.3s ease;
}

#mainmenu ul li a:hover .catalogue-download {
    opacity: 1;
    transform: translateY(2px);
}

</style>
